<?xml version="1.0"?>
<package >
  <metadata>
    <id>myFRpyarm32</id>
    <title>MyFRpy (ARM32)</title>
    <authors>MyFRpy Software Foundation</authors>
    <version>0.0.0.0</version>
    <licenseUrl>https://docs.myFRpy.org/3/license.html</licenseUrl>
    <projectUrl>https://www.myFRpy.org/</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Installs MyFRpy ARM32 for use in build scenarios.</description>
    <iconUrl>https://www.myFRpy.org/static/favicon.ico</iconUrl>
    <tags>myFRpy</tags>
  </metadata>
  <files>
    <file src="**\*" exclude="myFRpy.props" target="tools" />
    <file src="myFRpy.props" target="build\native\myFRpy.props" />
    <file src="myFRpy.props" target="build\native\myFRpyarm32.props" />
  </files>
</package>
