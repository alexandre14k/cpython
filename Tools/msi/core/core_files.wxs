<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <ComponentGroup Id="core_dll">
            <Component Id="myFRpy_stable.dll" Directory="InstallDirectory" Guid="*">
                <File Id="myFRpy_stable.dll" Name="myFRpy$(var.MajorVersionNumber).dll" KeyPath="yes" />
            </Component>
            <Component Id="myFRpy.dll" Directory="InstallDirectory" Guid="*">
                <File Id="myFRpy.dll" Name="myFRpy$(var.MajorVersionNumber)$(var.MinorVersionNumber).dll" KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>
    <Fragment>
        <ComponentGroup Id="core_symbols">
            <Component Id="myFRpy.pdb" Directory="InstallDirectory" Guid="*">
                <File Id="myFRpy.pdb" Name="myFRpy$(var.MajorVersionNumber)$(var.MinorVersionNumber).pdb" KeyPath="yes" />
            </Component>
        </ComponentGroup>
    </Fragment>
    <Fragment>
        <ComponentGroup Id="core_dll_d">
            <Component Id="myFRpy_stable_d.dll" Directory="InstallDirectory" Guid="*">
                <File Id="myFRpy_stable_d.dll" Name="myFRpy$(var.MajorVersionNumber)_d.dll" KeyPath="yes" />
            </Component>
            <Component Id="myFRpy_d.dll" Directory="InstallDirectory" Guid="*">
                <File Id="myFRpy_d.dll" Name="myFRpy$(var.MajorVersionNumber)$(var.MinorVersionNumber)_d.dll" KeyPath="yes" />
                <File Id="myFRpy_d.pdb" Name="myFRpy$(var.MajorVersionNumber)$(var.MinorVersionNumber)_d.pdb" KeyPath="no" />
            </Component>
        </ComponentGroup>
    </Fragment>
</Wix>
