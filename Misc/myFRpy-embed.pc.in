# See: man pkg-config
prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: MyFRpy
Description: Embed MyFRpy into an application
Requires:
Version: @VERSION@
Libs.private: @LIBS@
Libs: -L${libdir} -lmyFRpy@VERSION@@ABIFLAGS@
Cflags: -I${includedir}/myFRpy@VERSION@@ABIFLAGS@
